<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Nightly at 03:00 Bahrain time (00:00 UTC): loads yesterday and re-reads the last days.
         The very first run builds the whole history. -->
    <record id="cron_load_actuals" model="ir.cron">
        <field name="name">Sales Forecast: load daily actuals</field>
        <field name="model_id" ref="model_alkhuloodh_sf_actual_daily"/>
        <field name="state">code</field>
        <field name="code">model._cron_load_actuals()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 00:00:00')"/>
        <field name="active" eval="True"/>
    </record>
    <!-- 03:30 Bahrain time (00:30 UTC), after the actuals load. Sunday night's run is kept as the weekly snapshot. -->
    <record id="cron_run_forecast" model="ir.cron">
        <field name="name">Sales Forecast: nightly forecast refresh</field>
        <field name="model_id" ref="model_alkhuloodh_sf_run"/>
        <field name="state">code</field>
        <field name="code">model._cron_run_forecast()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 00:30:00')"/>
        <field name="active" eval="True"/>
    </record>
</odoo>

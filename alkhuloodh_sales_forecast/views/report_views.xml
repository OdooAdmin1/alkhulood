<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sf_report" model="ir.actions.client">
        <field name="name">Forecast report</field>
        <field name="tag">alkhuloodh_sf_report</field>
    </record>

    <record id="view_sf_report_branch_list" model="ir.ui.view">
        <field name="name">alkhuloodh.sf.report.branch.list</field>
        <field name="model">alkhuloodh.sf.report.branch</field>
        <field name="arch" type="xml">
            <list editable="bottom" create="0" delete="0">
                <field name="sequence" widget="handle"/>
                <field name="warehouse_id" readonly="1"/>
                <field name="short_name"/>
                <field name="show"/>
            </list>
        </field>
    </record>
    <record id="view_sf_report_branch_search" model="ir.ui.view">
        <field name="name">alkhuloodh.sf.report.branch.search</field>
        <field name="model">alkhuloodh.sf.report.branch</field>
        <field name="arch" type="xml">
            <search>
                <field name="warehouse_id"/>
                <field name="short_name"/>
                <filter name="shown" string="Shown in report" domain="[('show', '=', True)]"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>
    <record id="action_sf_report_branch" model="ir.actions.server">
        <field name="name">Report branches</field>
        <field name="model_id" ref="model_alkhuloodh_sf_report_branch"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open()</field>
    </record>

    <record id="view_sf_report_line_list" model="ir.ui.view">
        <field name="name">alkhuloodh.sf.report.line.list</field>
        <field name="model">alkhuloodh.sf.report.line</field>
        <field name="arch" type="xml">
            <list editable="bottom" decoration-warning="match_state == 'check'" decoration-danger="match_state == 'none'"
                  decoration-muted="not product_id">
                <header>
                    <button name="action_match" type="object" string="Match names to products" display="always"
                            class="btn-primary"/>
                </header>
                <field name="sequence" widget="handle"/>
                <field name="label"/>
                <field name="product_id"/>
                <field name="match_state" optional="show"/>
                <field name="match_note" optional="show"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>
    <record id="action_sf_report_line" model="ir.actions.act_window">
        <field name="name">Report products</field>
        <field name="res_model">alkhuloodh.sf.report.line</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add the products in the order the report should list them.</p>
        </field>
    </record>

    <record id="view_sf_viewer_branch_list" model="ir.ui.view">
        <field name="name">alkhuloodh.sf.viewer.branch.list</field>
        <field name="model">alkhuloodh.sf.viewer.branch</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="user_id"/>
                <field name="warehouse_id"/>
            </list>
        </field>
    </record>
    <record id="action_sf_viewer_branch" model="ir.actions.act_window">
        <field name="name">Viewer branches</field>
        <field name="res_model">alkhuloodh.sf.viewer.branch</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Give each Viewer (for example a POS user) the one branch they may see.</p>
            <p>A Viewer without a branch here sees nothing. Users and Managers always see all branches.</p>
        </field>
    </record>
</odoo>

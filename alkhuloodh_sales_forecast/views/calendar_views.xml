<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sf_calendar_list" model="ir.ui.view">
        <field name="name">alkhuloodh.sf.calendar.day.list</field>
        <field name="model">alkhuloodh.sf.calendar.day</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="date"/>
                <field name="hijri_text"/>
                <field name="ramadan_day"/>
                <field name="pos_eid_fitr" optional="show"/>
                <field name="pos_eid_adha" optional="show"/>
                <field name="pos_ashura" optional="show"/>
                <field name="pos_hijri_new_year" optional="show"/>
                <field name="fixed_event" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_sf_calendar_search" model="ir.ui.view">
        <field name="name">alkhuloodh.sf.calendar.day.search</field>
        <field name="model">alkhuloodh.sf.calendar.day</field>
        <field name="arch" type="xml">
            <search>
                <field name="date"/>
                <filter name="ramadan" string="Ramadan" domain="[('ramadan_day', '>', 0)]"/>
                <filter name="eid_fitr" string="Around Eid al-Fitr" domain="[('pos_eid_fitr', '!=', False)]"/>
                <filter name="eid_adha" string="Around Eid al-Adha" domain="[('pos_eid_adha', '!=', False)]"/>
            </search>
        </field>
    </record>
    <record id="action_sf_calendar" model="ir.actions.act_window">
        <field name="name">Hijri calendar</field>
        <field name="res_model">alkhuloodh.sf.calendar.day</field>
        <field name="view_mode">list</field>
    </record>
</odoo>

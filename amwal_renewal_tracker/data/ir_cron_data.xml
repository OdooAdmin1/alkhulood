<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_renewal_reminder" model="ir.cron">
        <field name="name">Renewal Tracker: Update Status &amp; Send Reminders</field>
        <field name="model_id" ref="model_renewal_tracker"/>
        <field name="state">code</field>
        <field name="code">model._cron_update_states_and_send_reminders()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>

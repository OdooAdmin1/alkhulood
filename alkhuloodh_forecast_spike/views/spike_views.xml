<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_spike_run_list" model="ir.ui.view">
        <field name="name">alkhuloodh.spike.run.list</field>
        <field name="model">alkhuloodh.spike.run</field>
        <field name="arch" type="xml">
            <list>
                <field name="create_date"/>
                <field name="via"/>
                <field name="state"/>
                <field name="end_date"/>
                <field name="seconds_total"/>
                <field name="cpu_seconds"/>
                <field name="peak_mb"/>
                <field name="company_forecast_total"/>
            </list>
        </field>
    </record>
    <record id="view_spike_run_form" model="ir.ui.view">
        <field name="name">alkhuloodh.spike.run.form</field>
        <field name="model">alkhuloodh.spike.run</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_run_now" type="object" string="Run now (in this request)" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group string="Result">
                            <field name="via"/>
                            <field name="end_date"/>
                            <field name="rows_loaded"/>
                            <field name="company_forecast_total"/>
                        </group>
                        <group string="Time and memory">
                            <field name="seconds_load"/>
                            <field name="seconds_prepare"/>
                            <field name="seconds_run"/>
                            <field name="seconds_total"/>
                            <field name="cpu_seconds"/>
                            <field name="peak_mb"/>
                        </group>
                    </group>
                    <group string="Yearly gross revenue ex-VAT (compare with the extract)">
                        <field name="yearly_totals" nolabel="1"/>
                    </group>
                    <group string="Log">
                        <field name="log" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_spike_run" model="ir.actions.act_window">
        <field name="name">Forecast spike runs</field>
        <field name="res_model">alkhuloodh.spike.run</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_spike_queue" model="ir.actions.server">
        <field name="name">Queue via scheduler</field>
        <field name="model_id" ref="model_alkhuloodh_spike_run"/>
        <field name="state">code</field>
        <field name="code">action = model.action_queue_cron()</field>
    </record>
    <menuitem id="menu_spike_root" name="Forecast Spike" sequence="999" groups="base.group_system"/>
    <menuitem id="menu_spike_runs" name="Runs" parent="menu_spike_root" action="action_spike_run" sequence="10"/>
    <menuitem id="menu_spike_queue" name="Queue via scheduler" parent="menu_spike_root" action="action_spike_queue" sequence="20"/>
</odoo>

<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!--
        Odoo renders the receipt footer as:

            <div class="... footer-powered-by">
                <span>Powered by <b> Odoo </b></span>
            </div>

        Replace that one block, matching on the footer-powered-by class rather
        than on the markup inside it, so a change to the wording upstream does
        not silently stop this override from applying.
    -->
    <t t-name="amwal_pos_receipt_branding.OrderReceiptAmwalFooter"
       t-inherit="point_of_sale.OrderReceipt"
       t-inherit-mode="extension">
        <xpath expr="//div[hasclass('footer-powered-by')]" position="replace">
            <div class="pos-receipt-order-data text-center pt-3 footer-powered-by">
                <span class="amwal-powered-by">
                    <span>Powered by</span>
                    <img class="amwal-powered-by-logo"
                         src="/amwal_pos_receipt_branding/static/src/img/amwal_logo.png"
                         alt="Amwal W.L.L"/>
                    <b>Amwal W.L.L</b>
                </span>
            </div>
        </xpath>
    </t>

</templates>

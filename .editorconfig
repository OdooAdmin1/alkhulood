root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{js,json,scss,css}]
indent_size = 4

[*.{xml,html}]
indent_size = 4
# Odoo view data is full of long single-line records; wrapping them breaks diffs
max_line_length = off

[*.{yml,yaml,md}]
indent_size = 2

[*.csv]
# ir.model.access.csv must stay exactly as Odoo writes it
trim_trailing_whitespace = false
insert_final_newline = false
